---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import DownloadButton from '../components/DownloadButton.astro';
import NewMenu from '../components/showcase/NewMenu.astro';
import Voice from '../components/showcase/Voice.astro';
import Ask from '../components/showcase/Ask.astro';
import ShortcutsTour from '../components/showcase/ShortcutsTour.astro';
import ToolCard from '../components/ToolCard.astro';
import Faq from '../components/Faq.astro';
import Flag from '../components/Flag.astro';
import { CHANGELOG_URL, DMG_URL, REPO_URL, VERSION, url } from '../data/site';
import '../styles/showcase.css';

const extras = [
  { title: 'Notch indicator', text: 'Small black wings at the notch while Maagical listens, thinks or speaks. Macs without a notch get the same shape in the menu bar.' },
  { title: 'History', text: 'Every read and every answer, kept on your Mac for as long as you choose. Read again, copy or delete.' },
  { title: 'Updates itself', text: "New versions install in the background while you're away from the keyboard, never mid-read." },
  { title: 'Careful with your clipboard', text: 'Restored after every copy and paste. Never pastes into a password field or a window you left.' },
  { title: 'Good with AirPods', text: 'Records on the built-in mic so your headphones stay in high-quality mode. Or pick a microphone yourself.' },
  { title: "Tells you what's missing", text: 'A missing permission shows in the menu with a button straight to the right System Settings page.' },
];

const keys = [
  { name: 'ElevenLabs', color: 'var(--read)', unlocks: 'The natural reading voice', without: 'The best Apple voice on your Mac', cost: 'Free allowance' },
  { name: 'Anthropic', color: 'var(--smart)', unlocks: 'Smart read and follow-up questions', without: 'Plain reading only', cost: 'Pay as you go' },
  { name: 'Groq', color: 'var(--dictation)', unlocks: 'Fast dictation with cleanup', without: "Apple's on-device recognizer (macOS 26)", cost: 'Free tier' },
  { name: 'Google sign-in', color: 'var(--tools)', unlocks: 'Meetings', without: 'No meeting item', cost: 'Free' },
];

const privacy = [
  { when: 'Read', what: 'The selected text, to ElevenLabs. With an Apple voice: nothing.' },
  { when: 'Smart read', what: 'The selected text, to Anthropic, then the brief to ElevenLabs.' },
  { when: 'Dictate', what: 'Your recording, to Groq. Without Groq on macOS 26: nothing, it stays on device.' },
  { when: 'Meetings', what: 'Nothing. Your calendars are read from Google, read-only, and kept in memory.' },
  { when: 'Never', what: 'History, recordings and keys. They stay on your Mac.' },
];

const faq = [
  { q: 'Do I need API keys?', a: 'No. Without any key Maagical reads with an Apple voice, dictates on device on macOS 26, and the clocks work. Keys unlock the ElevenLabs voice, smart read and faster dictation, and you pay those providers directly.' },
  { q: 'Do the shortcuts work on my keyboard layout?', a: 'Yes. Maagical uses the position, not the character: the three keys right above Option, next to M. On a German keyboard that is comma, period and minus; on a US keyboard comma, period and slash.' },
  { q: 'Which Macs does it run on?', a: 'Apple silicon and Intel Macs with macOS 15 Sequoia or later.' },
  { q: 'Why does it need Accessibility access?', a: 'To read the text you selected in other apps and to paste dictation where you were typing. It acts only when you press one of its keys.' },
  { q: 'How do updates work?', a: "Maagical checks every few hours and installs a new version while you're away from the keyboard. Check for Updates… in the menu looks right away." },
  { q: "Why isn't it in the Mac App Store?", a: "Store apps run in a sandbox that blocks global shortcuts and reading other apps' selections. Maagical is signed and notarized by Apple instead, and MIT licensed." },
];
---
<Base
  title="Maagical: your Mac, just better"
  description="Hear any text, ask it a question, dictate, transcribe a call, focus, keep awake. One small, free and open-source Mac app. No account, no subscription, no telemetry."
  path=""
  page="home"
>
  <section class="hero" id="top">
    <span class="hero-icon"><AppIcon size={96} /></span>
    <p class="eyebrow">Free and open source · macOS 15 or later</p>
    <h1>Your Mac, just better.<br />Quite Maagical.</h1>
    <p class="lead">Hear any text, ask it a question, dictate, transcribe a call, focus, keep awake. One small app, free and open source.</p>
    <div class="ctas">
      <a class="hero-dl" id="hero-dl" href={DMG_URL}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
        Download for Mac
      </a>
      <a class="ghost" href={REPO_URL}>Source on GitHub</a>
    </div>
  </section>

  <!-- The keys are the foundation of the app, so they come first; the rest builds on them. -->
  <ShortcutsTour />
  <Voice />
  <Ask />
  <NewMenu />

  <!-- Tools -->
  <section id="tools" class="wrap tools" aria-labelledby="tools-title">
    <div class="section-head">
      <p class="eyebrow">Tools</p>
      <h2 id="tools-title" class="h2">Small tools that wait in the menu bar.</h2>
      <p class="lead">Each one is a menu bar item, a switch in Settings and nothing more. They show up when they have something to tell you.</p>
    </div>
    <div class="cards cards-340">
      <ToolCard title="Meetings" href={url('meetings/')} linkText="More about Meetings">
        <Fragment slot="mockup">
          <div class="mb-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1D1D1F" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>Standup in 8m
          </div>
          <div class="mb-pop">
            <div class="mb-pop-head"><span><strong>Standup</strong><br /><span class="grey">10:00 – 10:15</span></span><span class="join">Join</span></div>
            <div class="mb-pop-later grey">11:30 Design review · 15:00 1:1</div>
          </div>
        </Fragment>
        <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
        Your next Google Calendar meeting appears ten minutes before it starts. One click joins the Meet, Zoom, Teams or Webex call. Focus time, all-day events and declined invites are skipped.
      </ToolCard>

      <ToolCard title="Clocks" href={url('clocks/')} linkText="More about Clocks">
        <Fragment slot="mockup">
          <div class="mb-item clocks">
            <span class="clock"><Flag country="IE" />13:05</span>
            <span class="clock"><Flag country="DE" />14:05</span>
            <span class="clock"><Flag country="JP" />22:05</span>
          </div>
        </Fragment>
        <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        The time where your team, clients or family are, next to yours, each with its flag. Add a clock by city, country, abbreviation or time zone.
      </ToolCard>
    </div>
  </section>

  <!-- Also in the box -->
  <section class="wrap extras" aria-labelledby="extras-title">
    <h2 id="extras-title" class="extras-title">Also in the box</h2>
    <div class="extras-grid">
      {extras.map((e) => (
        <div class="extra"><h3>{e.title}</h3><p>{e.text}</p></div>
      ))}
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="wrap pricing" aria-labelledby="pricing-title">
    <div class="section-head">
      <p class="eyebrow">Pricing</p>
      <h2 id="pricing-title" class="h2">Free. Works without any keys. Better with them.</h2>
      <p class="lead">Maagical costs nothing and has no subscription. Out of the box it reads with an Apple voice and dictates on device (macOS 26). Add a key to unlock more; you pay the provider directly, and most have a free tier. Keys live in your Keychain.</p>
    </div>
    <div class="table-box" role="region" aria-label="What each optional key unlocks" tabindex="0">
      <table class="keys-table">
        <caption class="visually-hidden">What each optional key unlocks</caption>
        <thead><tr><th scope="col">Key</th><th scope="col">Unlocks</th><th scope="col">Without it</th><th scope="col">Cost</th></tr></thead>
        <tbody>
          {keys.map((k) => (
            <tr>
              <th scope="row"><span class="key-name"><span class="kdot" style={`background: ${k.color}`} aria-hidden="true"></span>{k.name}</span></th>
              <td>{k.unlocks}</td>
              <td class="grey">{k.without}</td>
              <td class="grey">{k.cost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Privacy -->
  <div class="band-dark">
  <section id="privacy" class="wrap privacy" aria-labelledby="privacy-title">
    <div class="privacy-text">
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title" class="h2">Exactly what leaves your Mac.</h2>
      <p class="lead">There is no Maagical server. Text goes straight from your Mac to the provider you chose, only when you press a key. The code is public, so you can check.</p>
    </div>
    <div class="privacy-table">
      <table>
        <caption>Data sent per action</caption>
        <thead><tr><th scope="col">When you</th><th scope="col">What is sent, and to whom</th></tr></thead>
        <tbody>
          {privacy.map((p) => (
            <tr><th scope="row">{p.when}</th><td>{p.what}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  </div>

  <Faq title="Questions" items={faq} />

  <!-- Final CTA -->
  <section class="final" aria-labelledby="final-title">
    <div class="wrap final-inner">
      <AppIcon size={72} />
      <h2 id="final-title" class="final-title">Try it. It’s free.</h2>
      <p class="lead">Free, open source, and it keeps itself up to date.</p>
      <DownloadButton size="lg" />
      <p class="muted">Version {VERSION} · macOS 15 or later · <a href={CHANGELOG_URL}>What's new</a></p>
    </div>
  </section>
</Base>

<script>
  import '../scripts/home-motion';
</script>

<style>
  /* Hero download: the menu bar's Download pill watches it (#hero-dl). */
  .hero-dl {
    display: inline-flex; align-items: center; gap: 9px; min-height: 52px; padding: 0 24px; border-radius: var(--radius-pill);
    background: var(--dark); color: #FFFFFF; font-weight: 600; font-size: 17px; text-decoration: none; transition: transform 0.2s var(--ease), background 0.2s;
  }
  .hero-dl:hover { color: #FFFFFF; background: #000000; transform: translateY(-1px); }
  .hero-dl:focus-visible { outline-offset: 3px; }

  .tools { padding-top: 96px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 40px; }
  .cards { display: grid; gap: 20px; }
  .cards-340 { grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); }

  /* Tool mockups */
  .mb-item {
    align-self: flex-end; display: flex; align-items: center; gap: 6px; padding: 3px 9px;
    border-radius: 6px; background: #FFFFFF; font-size: 13px; font-weight: 500;
  }
  .mb-item.clocks { gap: 12px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .clock { display: flex; align-items: center; gap: 5px; }
  .mb-pop {
    align-self: flex-end; width: min(240px, 100%); display: flex; flex-direction: column; gap: 8px; padding: 12px;
    border-radius: 12px; background: #FFFFFF; box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.3); font-size: 13px;
  }
  .mb-pop-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .mb-pop-later { border-top: 1px solid var(--line); padding-top: 8px; }
  .join { padding: 6px 14px; border-radius: 14px; background: var(--tools); color: #FFFFFF; font-weight: 600; }
  .grey { color: var(--text-3); }

  /* Also in the box */
  .extras { padding-top: 64px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 28px; }
  .extras-title { font-weight: 700; font-size: 26px; letter-spacing: -0.015em; }
  .extras-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 28px 36px; }
  .extra { display: flex; flex-direction: column; gap: 6px; }
  .extra h3 { font-size: 17px; font-weight: 600; }
  .extra p { font-size: 15px; line-height: 1.55; color: var(--text-3); }

  /* Pricing */
  .pricing { padding-top: 96px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 36px; }
  .table-box { overflow-x: auto; border-radius: var(--radius-card); border: 1px solid var(--line); }
  .keys-table { width: 100%; min-width: 640px; font-size: 15px; line-height: 1.5; }
  .keys-table thead tr { background: var(--ground-2); }
  .keys-table th, .keys-table td { text-align: left; padding: 16px 20px; }
  .keys-table thead th { padding: 14px 20px; font-weight: 600; }
  .keys-table tbody > tr > * { border-top: 1px solid var(--line); }
  .keys-table tbody th { font-weight: 600; }
  .key-name { display: inline-flex; align-items: center; gap: 8px; }
  .kdot { width: 8px; height: 8px; border-radius: 4px; }

  /* Privacy */
  .privacy { padding-top: 96px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 48px; }
  .privacy-text { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .privacy-table { flex: 1.4 1 480px; min-width: 0; }
  .privacy-table table { width: 100%; font-size: 15px; line-height: 1.5; }
  .privacy-table caption { text-align: left; font-size: 13px; color: var(--text-3); padding-bottom: 10px; }
  .privacy-table thead th { text-align: left; padding: 12px 16px 12px 0; border-bottom: 2px solid var(--text); font-weight: 600; }
  .privacy-table tbody th { text-align: left; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); font-weight: 600; white-space: nowrap; vertical-align: top; }
  .privacy-table td { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--text-2); }

  /* Final CTA */
  /* Two dark moments for rhythm. They redefine the text tokens, so everything inside adapts. */
  .band-dark {
    --text: #F5F5F7; --text-2: #C7C7CC; --text-3: #A1A1A6; --line: rgba(255, 255, 255, 0.12); --line-2: rgba(255, 255, 255, 0.22);
    margin-top: 96px; background: #141416; color: var(--text);
  }
  .band-dark .privacy { padding-top: 96px; padding-bottom: 96px; }
  .final {
    --text: #FFFFFF; --text-2: rgba(255, 255, 255, 0.8); --text-3: rgba(255, 255, 255, 0.64); --link: #B4BEFF; --link-hover: #FFFFFF;
    padding: 96px 0 104px; background: #16133A; color: var(--text);
  }
  .final :global(.dl) { background: #FFFFFF; color: #16133A; }
  .final :global(.dl:hover) { background: #E9E8FF; color: #16133A; }
  .final-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .final-title { font-weight: 800; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.04; letter-spacing: -0.03em; }

  @media (max-width: 520px) {
    .tools, .pricing, .privacy { padding-top: 72px; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-dl { transition: none; } }
</style>
