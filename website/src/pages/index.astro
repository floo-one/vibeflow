---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Keyboard from '../components/Keyboard.astro';
import Keycaps from '../components/Keycaps.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ShortcutRow from '../components/ShortcutRow.astro';
import ToolCard from '../components/ToolCard.astro';
import Faq from '../components/Faq.astro';
import Flag from '../components/Flag.astro';
import { CHANGELOG_URL, REPO_URL, VERSION, url } from '../data/site';

const extras = [
  { title: 'Notch indicator', text: 'Small black wings at the notch while VibeFlow listens, thinks or speaks. Macs without a notch get the same shape in the menu bar.' },
  { title: 'History', text: 'Every read and every answer, kept on your Mac for as long as you choose. Read again, copy or delete.' },
  { title: 'Updates itself', text: "New versions install in the background while you're away from the keyboard, never mid-read." },
  { title: 'Careful with your clipboard', text: 'Restored after every copy and paste. Never pastes into a password field or a window you left.' },
  { title: 'Good with AirPods', text: 'Records on the built-in mic so your headphones stay in high-quality mode. Or pick a microphone yourself.' },
  { title: "Tells you what's missing", text: 'A missing permission shows in the menu with a button straight to the right System Settings page.' },
];

const keys = [
  { name: 'ElevenLabs', color: 'var(--read)', unlocks: 'The natural reading voice', without: 'The best Apple voice on your Mac', cost: 'Free allowance' },
  { name: 'Anthropic', color: 'var(--smart)', unlocks: 'Smart read and follow-up questions', without: 'Plain reading only', cost: 'Pay as you go' },
  { name: 'Groq', color: 'var(--dictation)', unlocks: 'Fast dictation with cleanup', without: "Apple's on-device recognizer (macOS 26)", cost: 'Free tier' },
  { name: 'Google sign-in', color: 'var(--tools)', unlocks: 'Meetings', without: 'No meeting item', cost: 'Free' },
];

const privacy = [
  { when: 'Read', what: 'The selected text, to ElevenLabs. With an Apple voice: nothing.' },
  { when: 'Smart read', what: 'The selected text, to Anthropic, then the brief to ElevenLabs.' },
  { when: 'Dictate', what: 'Your recording, to Groq. Without Groq on macOS 26: nothing, it stays on device.' },
  { when: 'Meetings', what: 'Nothing. Your calendars are read from Google, read-only, and kept in memory.' },
  { when: 'Never', what: 'History, recordings and keys. They stay on your Mac.' },
];

const faq = [
  { q: 'Do I need API keys?', a: 'No. Without any key VibeFlow reads with an Apple voice, dictates on device on macOS 26, and the clocks work. Keys unlock the ElevenLabs voice, smart read and faster dictation, and you pay those providers directly.' },
  { q: 'Do the shortcuts work on my keyboard layout?', a: 'Yes. VibeFlow uses the position, not the character: the three keys right above Option, next to M. On a German keyboard that is comma, period and minus; on a US keyboard comma, period and slash.' },
  { q: 'Which Macs does it run on?', a: 'Apple silicon and Intel Macs with macOS 15 Sequoia or later.' },
  { q: 'Why does it need Accessibility access?', a: 'To read the text you selected in other apps and to paste dictation where you were typing. It acts only when you press one of its keys.' },
  { q: 'How do updates work?', a: "VibeFlow checks every few hours and installs a new version while you're away from the keyboard. Check for Updates… in the menu looks right away." },
  { q: "Why isn't it in the Mac App Store?", a: "Store apps run in a sandbox that blocks global shortcuts and reading other apps' selections. VibeFlow is signed and notarized by Apple instead, and MIT licensed." },
];
---
<Base
  title="VibeFlow: hear anything, say anything"
  description="A free, open-source Mac menu bar app. Option and the three keys right above it read, explain and dictate in every app. No account, no subscription, no telemetry."
  path=""
  page="home"
>
  <!-- Hero -->
  <section id="top" class="wrap hero">
    <div class="hero-text">
      <p class="eyebrow">Free and open source · macOS 15 or later</p>
      <h1 class="display">Hear anything.<br />Say anything.</h1>
      <p class="intro">A small Mac menu bar app. Option and the three keys right above it give your Mac a voice: one explains, one reads, one types what you say. A few quiet tools come with it.</p>
      <div class="ctas">
        <DownloadButton icon />
        <a class="ghost" href={REPO_URL}>Source on GitHub</a>
      </div>
      <p class="muted">Signed and notarized by Apple. Updates itself. No account, no subscription, no telemetry.</p>
    </div>
    <div class="hero-kb">
      <Keyboard />
    </div>
  </section>

  <!-- Grammar strip -->
  <section class="strip" aria-label="How the shortcuts work">
    <div class="wrap grammar">
      <div class="g"><Keycaps keys={['⌥', 'key']} /><span>the selection, or dictate</span></div>
      <div class="g"><Keycaps keys={['⇧', '⌥', 'key']} /><span>the clipboard instead</span></div>
      <div class="g"><Keycaps keys={['hold']} /><span>and talk: ask, or dictate</span></div>
      <p class="muted">Tap the same key again to stop. Every shortcut can be changed.</p>
    </div>
  </section>

  <!-- Voice -->
  <section id="voice" class="wrap voice" aria-labelledby="voice-title">
    <div class="section-head">
      <p class="eyebrow">Voice</p>
      <h2 id="voice-title" class="h2 h2-lg">Three keys. Works in every app.</h2>
      <p class="lead">No window to open and no box to paste into. Select text in Mail, Safari, Slack, a PDF or ChatGPT and press a key.</p>
    </div>
    <div class="cards cards-310">
      <FeatureCard title="Read" subtitle="Selected text, aloud" color="var(--read)">
        <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 10v4M8 6v12M12 3v18M16 7v10M20 10v4" /></svg>
        <Fragment slot="text">A natural ElevenLabs voice, usually in well under a second. Tables, links and Markdown are rewritten for listening. Without a key, the best Apple voice on your Mac reads instead.</Fragment>
        <ShortcutRow label="Read selection" hint="Tap again to stop" keys={['⌥', '.']} />
        <ShortcutRow label="Read clipboard" keys={['⇧', '⌥', '.']} />
      </FeatureCard>

      <FeatureCard title="Smart read" subtitle="A spoken brief, then ask about it" color="var(--smart)">
        <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8z" /><path d="M18.5 15l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z" /></svg>
        <Fragment slot="text">Claude tells you what the text means in a few spoken sentences: what an email wants and by when, a contract's money and deadlines, an error's likely fix. Hold the key to ask a follow-up out loud.</Fragment>
        <ShortcutRow label="Smart read selection" keys={['⌥', ',']} />
        <ShortcutRow label="Ask a follow-up" hint="Hold, speak, let go" keys={['hold', '⌥', ',']} />
        <ShortcutRow label="Smart read clipboard" keys={['⇧', '⌥', ',']} />
        <ShortcutRow label="Paste again" keys={['⇧', '⌥', '⌘', 'V']} />
      </FeatureCard>

      <FeatureCard title="Dictation" subtitle="Speak, it types" color="var(--dictation)">
        <svg slot="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg>
        <Fragment slot="text">Hold, talk, let go. Your words are transcribed, cleaned up and pasted where you were typing, in about 0.8 seconds. Punctuation, casing and misheard words are fixed for you. The key is the one right of the period: - on German keyboards, / on US.</Fragment>
        <ShortcutRow label="Dictate" hint="Hold, speak, let go: it is pasted" keys={['hold', '⌥', '-']} />
        <ShortcutRow label="Hands-free" hint="Tap again to stop" keys={['⇧', '⌥', '-']} />
        <ShortcutRow label="Paste again" keys={['⌥', '⌘', 'V']} />
      </FeatureCard>
    </div>
  </section>

  <!-- AI replies band -->
  <section class="band-outer" aria-labelledby="ai-title">
    <div class="band">
      <div class="band-text">
        <p class="band-eyebrow"><span class="dot" aria-hidden="true"></span>Smart read, made for AI chat</p>
        <h2 id="ai-title" class="h2">Stop reading walls of AI text. Listen to them.</h2>
        <p class="band-lead">In the ChatGPT, Claude, Codex and Gemini apps, smart read speaks the reply as that assistant, in first person, and ends on what it needs from you. Then hold the key and answer back by voice.</p>
        <ul class="band-list">
          <li>Leads with what matters, keeps numbers and dates exactly</li>
          <li>Warnings about data, security or money are never dropped</li>
          <li>The answer starts speaking after its first sentence</li>
        </ul>
      </div>
      <div class="chat" role="group" aria-label="Example: a long AI reply and what smart read says instead">
        <div class="bubble me">Can you refactor the auth module to use the new token service?</div>
        <div class="bubble ai">I've moved token refresh into TokenService and updated 14 call sites… <span class="more">(1,200 more words)</span></div>
        <div class="spoken">
          <span class="tile spoken-tile" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linejoin="round"><path d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8z" /></svg></span>
          <span>“I moved token refresh into one place and touched fourteen files. Two tests fail on the old mock. Should I update the mock, or keep the old path for now?”</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section id="tools" class="wrap tools" aria-labelledby="tools-title">
    <div class="section-head">
      <p class="eyebrow">Tools</p>
      <h2 id="tools-title" class="h2">Small tools that wait in the menu bar.</h2>
      <p class="lead">Each one is a menu bar item, a switch in Settings and nothing more. They show up when they have something to tell you.</p>
    </div>
    <div class="cards cards-340">
      <ToolCard title="Meetings" href={url('meetings/')} linkText="More about Meetings">
        <Fragment slot="mockup">
          <div class="mb-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1D1D1F" stroke-width="2" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>Standup in 8m
          </div>
          <div class="mb-pop">
            <div class="mb-pop-head"><span><strong>Standup</strong><br /><span class="grey">10:00 – 10:15</span></span><span class="join">Join</span></div>
            <div class="mb-pop-later grey">11:30 Design review · 15:00 1:1</div>
          </div>
        </Fragment>
        <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></svg>
        Your next Google Calendar meeting appears ten minutes before it starts. One click joins the Meet, Zoom, Teams or Webex call. Focus time, all-day events and declined invites are skipped.
      </ToolCard>

      <ToolCard title="Clocks" href={url('clocks/')} linkText="More about Clocks">
        <Fragment slot="mockup">
          <div class="mb-item clocks">
            <span class="clock"><Flag country="IE" />13:05</span>
            <span class="clock"><Flag country="DE" />14:05</span>
            <span class="clock"><Flag country="JP" />22:05</span>
          </div>
        </Fragment>
        <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        The time where your team, clients or family are, next to yours, each with its flag. Add a clock by city, country, abbreviation or time zone.
      </ToolCard>
    </div>
  </section>

  <!-- Also in the box -->
  <section class="wrap extras" aria-labelledby="extras-title">
    <h2 id="extras-title" class="extras-title">Also in the box</h2>
    <div class="extras-grid">
      {extras.map((e) => (
        <div class="extra"><h3>{e.title}</h3><p>{e.text}</p></div>
      ))}
    </div>
  </section>

  <!-- Pricing -->
  <section id="keys" class="wrap pricing" aria-labelledby="pricing-title">
    <div class="section-head">
      <p class="eyebrow">Pricing</p>
      <h2 id="pricing-title" class="h2">Free. Works without any keys. Better with them.</h2>
      <p class="lead">VibeFlow costs nothing and has no subscription. Out of the box it reads with an Apple voice and dictates on device (macOS 26). Add a key to unlock more; you pay the provider directly, and most have a free tier. Keys live in your Keychain.</p>
    </div>
    <div class="table-box" role="region" aria-label="What each optional key unlocks" tabindex="0">
      <table class="keys-table">
        <caption class="visually-hidden">What each optional key unlocks</caption>
        <thead><tr><th scope="col">Key</th><th scope="col">Unlocks</th><th scope="col">Without it</th><th scope="col">Cost</th></tr></thead>
        <tbody>
          {keys.map((k) => (
            <tr>
              <th scope="row"><span class="key-name"><span class="kdot" style={`background: ${k.color}`} aria-hidden="true"></span>{k.name}</span></th>
              <td>{k.unlocks}</td>
              <td class="grey">{k.without}</td>
              <td class="grey">{k.cost}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Privacy -->
  <section id="privacy" class="wrap privacy" aria-labelledby="privacy-title">
    <div class="privacy-text">
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title" class="h2">Exactly what leaves your Mac.</h2>
      <p class="lead">There is no VibeFlow server. Text goes straight from your Mac to the provider you chose, only when you press a key. The code is public, so you can check.</p>
    </div>
    <div class="privacy-table">
      <table>
        <caption>Data sent per action</caption>
        <thead><tr><th scope="col">When you</th><th scope="col">What is sent, and to whom</th></tr></thead>
        <tbody>
          {privacy.map((p) => (
            <tr><th scope="row">{p.when}</th><td>{p.what}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Faq title="Questions" items={faq} />

  <!-- Final CTA -->
  <section class="final" aria-labelledby="final-title">
    <div class="wrap final-inner">
      <AppIcon size={72} />
      <h2 id="final-title" class="final-title">Give your Mac a voice.</h2>
      <p class="lead">Free, open source, and it keeps itself up to date.</p>
      <DownloadButton size="lg" />
      <p class="muted">Version {VERSION} · macOS 15 or later · <a href={CHANGELOG_URL}>What's new</a></p>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-top: 80px; padding-bottom: 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .hero-text { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .hero-kb { flex: 1 1 500px; min-width: 0; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .ghost {
    display: inline-flex; align-items: center; min-height: 52px; padding: 0 22px;
    border-radius: var(--radius-pill); border: 1px solid var(--line-2);
    color: var(--text); text-decoration: none; font-size: 17px; font-weight: 600;
  }
  .ghost:hover { color: var(--text); background: var(--ground-2); }

  /* Grammar strip */
  .strip { background: var(--ground-2); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .grammar {
    padding-top: 28px; padding-bottom: 28px; display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 20px 32px; align-items: center;
  }
  .g { display: flex; align-items: center; gap: 14px; font-size: 16px; font-weight: 600; }

  /* Voice and Tools */
  .voice { padding-top: 104px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 44px; }
  .h2-lg { font-size: clamp(32px, 4vw, 48px); line-height: 1.05; }
  .tools { padding-top: 96px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 40px; }
  .cards { display: grid; gap: 20px; }
  .cards-310 { grid-template-columns: repeat(auto-fit, minmax(min(310px, 100%), 1fr)); }
  .cards-340 { grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr)); }

  /* Dark band */
  .band-outer { padding: 40px var(--gutter); }
  .band {
    max-width: var(--max); margin: 0 auto; border-radius: 28px; background: var(--dark); color: var(--dark-text);
    padding: clamp(28px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 48px; align-items: center;
  }
  .band-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .band-eyebrow { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: #A9A2FF; }
  .dot { width: 10px; height: 10px; border-radius: 5px; background: #8F86FF; }
  .band-lead { font-size: 17px; line-height: 1.6; color: var(--dark-text-2); }
  .band-list { padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 16px; color: #E5E5EA; }
  .chat { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .bubble { padding: 14px 18px; font-size: 15px; line-height: 1.5; }
  .me { align-self: flex-end; max-width: 85%; border-radius: 18px 18px 4px 18px; background: #3A3A3F; }
  .ai { max-width: 92%; border-radius: 18px 18px 18px 4px; background: var(--dark-2); color: var(--dark-text-2); line-height: 1.55; }
  .ai .more { color: #A1A1A6; }
  .spoken {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 16px;
    background: var(--dark-2); border: 1px solid var(--smart); font-size: 15px; line-height: 1.5;
  }
  .spoken-tile { width: 32px; height: 32px; border-radius: 8px; background: var(--smart); }

  /* Tool mockups */
  .mb-item {
    align-self: flex-end; display: flex; align-items: center; gap: 6px; padding: 3px 9px;
    border-radius: 6px; background: #FFFFFF; font-size: 13px; font-weight: 500;
  }
  .mb-item.clocks { gap: 12px; font-weight: 400; font-variant-numeric: tabular-nums; }
  .clock { display: flex; align-items: center; gap: 5px; }
  .mb-pop {
    align-self: flex-end; width: min(240px, 100%); display: flex; flex-direction: column; gap: 8px; padding: 12px;
    border-radius: 12px; background: #FFFFFF; box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.3); font-size: 13px;
  }
  .mb-pop-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .mb-pop-later { border-top: 1px solid var(--line); padding-top: 8px; }
  .join { padding: 6px 14px; border-radius: 14px; background: var(--tools); color: #FFFFFF; font-weight: 600; }
  .grey { color: var(--text-3); }

  /* Also in the box */
  .extras { padding-top: 64px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 28px; }
  .extras-title { font-weight: 700; font-size: 26px; letter-spacing: -0.015em; }
  .extras-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 28px 36px; }
  .extra { display: flex; flex-direction: column; gap: 6px; }
  .extra h3 { font-size: 17px; font-weight: 600; }
  .extra p { font-size: 15px; line-height: 1.55; color: var(--text-3); }

  /* Pricing */
  .pricing { padding-top: 96px; padding-bottom: 40px; display: flex; flex-direction: column; gap: 36px; }
  .table-box { overflow-x: auto; border-radius: var(--radius-card); border: 1px solid var(--line); }
  .keys-table { width: 100%; min-width: 640px; font-size: 15px; line-height: 1.5; }
  .keys-table thead tr { background: var(--ground-2); }
  .keys-table th, .keys-table td { text-align: left; padding: 16px 20px; }
  .keys-table thead th { padding: 14px 20px; font-weight: 600; }
  .keys-table tbody > tr > * { border-top: 1px solid var(--line); }
  .keys-table tbody th { font-weight: 600; }
  .key-name { display: inline-flex; align-items: center; gap: 8px; }
  .kdot { width: 8px; height: 8px; border-radius: 4px; }

  /* Privacy */
  .privacy { padding-top: 96px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 48px; }
  .privacy-text { flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .privacy-table { flex: 1.4 1 480px; min-width: 0; }
  .privacy-table table { width: 100%; font-size: 15px; line-height: 1.5; }
  .privacy-table caption { text-align: left; font-size: 13px; color: var(--text-3); padding-bottom: 10px; }
  .privacy-table thead th { text-align: left; padding: 12px 16px 12px 0; border-bottom: 2px solid var(--text); font-weight: 600; }
  .privacy-table tbody th { text-align: left; padding: 14px 16px 14px 0; border-bottom: 1px solid var(--line); font-weight: 600; white-space: nowrap; vertical-align: top; }
  .privacy-table td { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--text-2); }

  /* Final CTA */
  .final { padding: 80px 0 96px; }
  .final-inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; }
  .final-title { font-weight: 800; font-size: clamp(34px, 4.6vw, 56px); line-height: 1.04; letter-spacing: -0.03em; }

  @media (max-width: 520px) {
    .hero { padding-top: 48px; gap: 40px; }
    .voice, .tools, .pricing, .privacy { padding-top: 72px; }
    .band-outer { padding-left: 12px; padding-right: 12px; }
  }
</style>
