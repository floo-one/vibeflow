---
// The 1200×630 social card. Screenshot it to public/og.png (see docs/DEVELOPMENT.md "Website").
import '@fontsource-variable/inter';
import '../styles/global.css';
import AppIcon from '../components/AppIcon.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>Maagical social card</title>
  </head>
  <body>
    <main class="card">
      <div class="brand"><AppIcon size={56} />Maagical</div>
      <div class="bottom">
        <div class="text">
          <h1>Your Mac, just better.<br />Quite Maagical.</h1>
          <p>Free Mac app. Hear any text, ask it a question, dictate.</p>
        </div>
        <div class="cluster" aria-hidden="true">
          <div class="three">
            <div class="key" style="background: var(--smart)">,<small>Smart read</small></div>
            <div class="key" style="background: var(--read)">.<small>Read</small></div>
            <div class="key" style="background: var(--dictation)">-<small>Dictation</small></div>
          </div>
          <div class="key opt">⌥<small>option</small></div>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  body { background: var(--dark); }
  .card {
    width: 1200px; height: 630px; padding: 64px 72px; background: var(--dark); color: var(--dark-text);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter Variable", sans-serif;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  .brand { display: flex; align-items: center; gap: 16px; font-size: 32px; font-weight: 700; }
  .bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; }
  .text { display: flex; flex-direction: column; gap: 22px; }
  h1 { font-weight: 800; font-size: 96px; line-height: 0.98; letter-spacing: -0.04em; }
  p { font-size: 28px; color: var(--dark-text-2); }
  .cluster { display: flex; flex-direction: column; gap: 10px; padding: 18px; border-radius: 22px; background: var(--dark-2); }
  .three { display: flex; gap: 10px; }
  .key {
    width: 96px; height: 96px; flex: none; border-radius: 14px; padding: 12px;
    display: flex; flex-direction: column; justify-content: space-between;
    color: #FFFFFF; font-weight: 700; font-size: 38px; line-height: 1;
  }
  .key small { font-size: 13px; font-weight: 600; white-space: nowrap; color: rgba(255, 255, 255, 0.95); }
  .key.opt { width: 110px; background: var(--dark-text); color: var(--text); }
  .key.opt small { color: var(--text); }
</style>
