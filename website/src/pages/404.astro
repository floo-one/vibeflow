---
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { url } from '../data/site';
---
<Base
  title="Page not found · Maagical"
  description="This page does not exist. Maagical is a free Mac menu bar app to read, explain and dictate."
  path="404/"
  noindex
>
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1 class="h2">This page doesn't exist.</h1>
    <p class="lead">The link may be old, or the page moved.</p>
    <div class="ctas">
      <a class="ghost" href={url()}>Go to the home page</a>
      <DownloadButton />
    </div>
  </section>
</Base>

<style>
  .nf { padding-top: 120px; padding-bottom: 140px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .ghost {
    display: inline-flex; align-items: center; min-height: 52px; padding: 0 22px;
    border-radius: var(--radius-pill); border: 1px solid var(--line-2);
    color: var(--text); text-decoration: none; font-size: 17px; font-weight: 600;
  }
  .ghost:hover { color: var(--text); background: var(--ground-2); }
</style>
