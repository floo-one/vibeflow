---
import AppIcon from './AppIcon.astro';
import DownloadButton from './DownloadButton.astro';
import { REPO_URL, url } from '../data/site';

// "home": the landing page's in-page links; "tool": the Meetings and Clocks pages.
interface Props { variant?: 'home' | 'tool'; current?: 'meetings' | 'clocks' }
const { variant = 'home', current } = Astro.props;

const links = variant === 'home'
  ? [
      { href: '#voice', label: 'Voice' },
      { href: '#tools', label: 'Tools' },
      { href: '#keys', label: 'Pricing' },
      { href: '#privacy', label: 'Privacy' },
      { href: '#faq', label: 'FAQ' },
    ]
  : [
      { href: url('#voice'), label: 'Voice' },
      { href: url('meetings/'), label: 'Meetings', page: 'meetings' },
      { href: url('clocks/'), label: 'Clocks', page: 'clocks' },
    ];
---
<header class="bar">
  <nav aria-label="Main" class="wrap nav">
    <a class="logo" href={url()}>
      <AppIcon size={30} />
      VibeFlow
    </a>
    {links.map((l) => (
      <a class="link" href={l.href} aria-current={'page' in l && l.page === current ? 'page' : undefined}>{l.label}</a>
    ))}
    <a class="link" href={REPO_URL}>GitHub</a>
    <DownloadButton size="sm" label="Download" />
  </nav>
</header>

<style>
  .bar { border-bottom: 1px solid var(--line); background: rgba(255, 255, 255, 0.9); }
  .nav {
    padding-top: 14px; padding-bottom: 14px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 28px;
  }
  .logo {
    display: flex; align-items: center; gap: 10px; min-height: 44px; margin-right: auto;
    text-decoration: none; color: var(--text); font-weight: 700; font-size: 19px;
  }
  .logo:hover { color: var(--text); }
  .link {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--text-2); text-decoration: none; font-size: 15px; font-weight: 500;
  }
  .link:hover { color: var(--text); }
  .link[aria-current='page'] { color: var(--text); font-weight: 700; }
  @media (max-width: 640px) {
    .nav { gap: 0 20px; }
    .logo { flex-basis: 100%; }
  }
</style>
