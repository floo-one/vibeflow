---
// Voice: the three keys. Each feature plays its moment on an email in the scene (Read
// highlights it word by word, Smart read speaks a brief, Dictation types a reply). On wide
// screens the section pins and the scroll plays the three beats, snapping to each; on phones
// they cycle on their own. With reduced motion each feature is one still frame.
import Glyph from './Glyph.astro';
import Get from './Get.astro';
import Notch from './Notch.astro';

const feats = [
  { f: 'read', c: 'var(--read)', title: 'Read', key: '.', text: 'Any selected text, in a natural voice, in under a second.' },
  { f: 'smart', c: 'var(--smart)', title: 'Smart read', key: ',', text: 'What it means, in a few spoken sentences. Hold the key to ask back.' },
  { f: 'dict', c: 'var(--dictation)', title: 'Dictation', key: '-', hold: true, text: 'Talk, let go, and it’s typed where you were, cleaned up.' },
];
---
<section class="show flip" id="voice" aria-labelledby="voice-title">
  <div class="copy">
    <p class="eyebrow">Voice</p>
    <h2 id="voice-title">Three keys.<br />Every app.</h2>
    <p class="lead">Option and the three keys right above it. Select text anywhere, press one, and your Mac talks back. Or talk, and it types.</p>
    <ul class="feats" id="vfeats">
      {feats.map((x) => (
        <li><button class="feat" type="button" data-f={x.f} style={`--c: ${x.c}`}>
          <div class="feat-row">
            <h3>{x.title}</h3>
            <span class="keys">
              {x.hold && <span class="hold">hold</span>}
              <span class="k">⌥</span><span class:list={['k key', { dk: x.f === 'dict' }]}>{x.key}</span>
            </span>
          </div>
          <p>{x.text}</p>
        </button></li>
      ))}
    </ul>
    <Get note="Works without any keys · no account" />
  </div>

  <div class="vstage" id="vstage">
  <div class="scene vscene" id="vscene" role="img" aria-label="An email in a Mac window: Read highlights it word by word, Smart read speaks a one-line brief, Dictation types a reply">
    <div class="bar" aria-hidden="true">
      <span class="bar-app">Mail</span>
      <Notch id="vnotch" icons={['read', 'smart', 'dict']} />
      <span style="padding-right: 8px"><Glyph /></span>
    </div>

    <div class="card" id="vcard" aria-hidden="true">
      <p class="from"><b>Lena Hoffmann</b> · Lisbon offsite</p>
      <p class="body" id="vbody">Three things I need from you by Friday: your arrival time, any dietary needs, and whether you want to join the boat trip on Thursday.</p>
      <div class="field" id="vfield"></div>
    </div>

    <div class="pill" id="vpill" aria-hidden="true">
      <span class="tile"><svg width="15" height="15" viewBox="0 0 24 24" fill="#FFFFFF"><path d="M11 3l1.8 5.2L18 10l-5.2 1.8L11 17l-1.8-5.2L4 10l5.2-1.8z" /></svg></span>
      <span id="vbrief">Lena needs three answers by Friday: when you land, what you eat, and yes or no to the boat.</span>
    </div>
  </div>
  </div>
</section>

<style>
  /* Phones, scroll-driven: headline first, then the Mail scene with the three features right under
     it, so scene and features fit one screen while the section is pinned. */
  @media (max-width: 900px) {
    #voice.scrub-phone { row-gap: 0; }
    #voice.scrub-phone .copy { display: contents; }
    #voice.scrub-phone .eyebrow { order: 1; }
    #voice.scrub-phone h2 { order: 2; }
    #voice.scrub-phone .lead { order: 3; }
    #voice.scrub-phone .vstage { order: 4; margin: 28px 0 8px; }
    #voice.scrub-phone .feats { order: 5; margin-top: 0; }
    #voice.scrub-phone .get { order: 6; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, MOTION } from '../../scripts/motion';

  type F = 'read' | 'smart' | 'dict';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const section = $('voice');
  const feats = [...section.querySelectorAll<HTMLElement>('.feat')];
  const notch = $('vnotch'), card = $('vcard'), field = $('vfield'), pill = $('vpill');
  const TINT: Record<F, string> = { read: '#4C9BFF', smart: '#9D95FF', dict: '#FF6B5E' };
  const REPLY = 'Friday works. I land Thursday at 9, no dietary needs, and yes to the boat!';
  const ORDER: F[] = ['read', 'smart', 'dict'];
  const split = (el: HTMLElement) => {
    el.innerHTML = (el.textContent ?? '').split(' ').map((w) => `<span class="w">${w}</span>`).join(' ');
    return [...el.querySelectorAll<HTMLElement>('.w')];
  };
  const words = split($('vbody')), briefWords = split($('vbrief'));
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let run = 0, auto = 0, cycling = false, visible = false, scrubbing = false;
  let current: F | null = null;
  const fOf = (el: HTMLElement) => el.dataset.f as F;

  function reset() {
    words.forEach((w) => w.classList.remove('on'));
    briefWords.forEach((w) => w.classList.remove('said'));
    pill.classList.remove('is-on'); card.classList.remove('dim');
    field.textContent = ''; field.classList.remove('typing');
    notch.classList.remove('on');
  }
  function mark(f: F) {
    feats.forEach((x) => x.classList.toggle('on', fOf(x) === f));
    notch.dataset.f = f; notch.style.setProperty('--tint', TINT[f]);
  }

  // Reduced motion: each feature is one still frame, chosen by hover or focus, never cycled.
  function still(f: F) {
    run++; current = f; reset(); mark(f);
    notch.classList.add('on');
    if (f === 'read') words.slice(8, 14).forEach((w) => w.classList.add('on'));
    else if (f === 'smart') { card.classList.add('dim'); pill.classList.add('is-on'); briefWords.forEach((w) => w.classList.add('said')); }
    else field.textContent = REPLY;
  }

  async function play(f: F) {
    if (reduced) return still(f);
    const my = ++run; current = f; reset(); mark(f);
    await wait(200); if (my !== run) return;
    notch.classList.add('on');
    if (f === 'read') {
      for (let i = 0; i < words.length; i++) {
        if (my !== run) return;
        words.forEach((w, j) => w.classList.toggle('on', j === i));
        await wait(185);
      }
      words.forEach((w) => w.classList.remove('on'));
    } else if (f === 'smart') {
      card.classList.add('dim');
      await wait(700); if (my !== run) return; // thinking
      pill.classList.add('is-on');
      for (const w of briefWords) { if (my !== run) return; w.classList.add('said'); await wait(210); }
    } else {
      field.classList.add('typing');
      await wait(1800); if (my !== run) return; // listening while the key is held
      field.classList.remove('typing');
      field.innerHTML = `<span class="pasted">${REPLY}</span>`;
    }
    await wait(500); if (my === run) notch.classList.remove('on');
    await wait(f === 'read' ? 600 : 1800);
    if (my === run && cycling) play(fOf(feats[++auto % feats.length]));
  }
  function startCycle() {
    if (scrubbing) return;
    if (reduced) { if (!current) still('smart'); return; }
    if (cycling) return;
    cycling = true; play(fOf(feats[auto % feats.length]));
  }

  feats.forEach((el, i) => {
    const pick = () => {
      if (scrubbing) return;
      cycling = false; auto = i; if (current !== fOf(el) || !notch.classList.contains('on')) play(fOf(el));
    };
    el.addEventListener('mouseenter', pick);
    el.addEventListener('focus', pick);
    el.addEventListener('click', () => { if (scrubbing) goTo(i); });
  });
  $('vfeats').addEventListener('mouseleave', () => setTimeout(() => {
    if (!scrubbing && !section.querySelector('.feat:hover')) { auto++; startCycle(); }
  }, 1600));

  new IntersectionObserver(([e]) => {
    const now = e.intersectionRatio >= 0.35;
    if (now === visible) return;
    visible = now;
    if (scrubbing) return;
    if (now) setTimeout(() => { if (visible) startCycle(); }, 500);
    else if (!reduced) { cycling = false; run++; reset(); }
  }, { threshold: [0, 0.35] }).observe(section);

  // ---------- Scroll-driven: the section pins and the scroll plays the three beats ----------
  // Every frame is drawn from the scroll position alone, so scrolling back plays it in reverse.
  // Each beat rests where its moment reads best; one scroll gesture moves to the next rest.
  const BAR = 44;
  const REST = [0.55, 0.9, 0.9]; // where each beat comes to rest, within the beat
  const band = (t: number, a: number, b: number) => gsap.utils.clamp(0, 1, (t - a) / (b - a));
  const POINTS = [0, ...REST.map((r, i) => (i + r) / 3), 1];
  const nextPoint = ScrollTrigger.snapDirectional(POINTS);
  let st: ScrollTrigger | null = null;
  let shown = '', jumping = false;

  function render(p: number) {
    const n = Math.min(2, Math.floor(p * 3)), t = p * 3 - n, f = ORDER[n];
    if (current !== f) { current = f; mark(f); }
    feats.forEach((x, i) => x.style.setProperty('--p', String(i < n ? 1 : i > n ? 0 : t)));
    notch.classList.toggle('on', t > 0.04 && t < 0.97);

    // Read: a highlight walks the email, word by word.
    const at = f === 'read' && t > 0.06 && t < 0.92 ? Math.floor(band(t, 0.06, 0.92) * words.length) : -1;
    words.forEach((w, j) => w.classList.toggle('on', j === at));

    // Smart read: the email dims while it thinks, then the brief is spoken word by word.
    card.classList.toggle('dim', f === 'smart' && t > 0.08);
    pill.classList.toggle('is-on', f === 'smart' && t > 0.24);
    const said = f === 'smart' ? Math.round(band(t, 0.3, 0.85) * briefWords.length) : 0;
    briefWords.forEach((w, j) => w.classList.toggle('said', j < said));

    // Dictation: listening while the key is held, then the cleaned-up reply lands at once.
    const state = f !== 'dict' || t < 0.08 ? 'empty' : t < 0.55 ? 'typing' : 'pasted';
    if (state !== shown) {
      shown = state;
      field.classList.toggle('typing', state === 'typing');
      if (state === 'pasted') field.innerHTML = `<span class="pasted">${REPLY}</span>`;
      else field.textContent = '';
    }
  }

  function goTo(i: number) {
    if (!st) return;
    const y = st.start + ((i + REST[i]) / 3) * (st.end - st.start);
    // A click lands on a rest point; the snap must not read that as a push to the next one.
    jumping = true;
    gsap.to(window, { scrollTo: y, duration: 1, ease: 'power2.inOut', overwrite: true, onComplete: () => { setTimeout(() => { jumping = false; }, 400); } });
  }

  gsap.matchMedia().add(`${MOTION} and (min-width: 901px) and (min-height: 620px)`, () => {
    scrubbing = true; cycling = false; run++; reset(); shown = '';
    section.classList.add('scrub');
    const proxy = { p: 0 };
    const tween = gsap.to(proxy, {
      p: 1, ease: 'none',
      onUpdate: () => render(proxy.p),
      scrollTrigger: {
        trigger: section,
        pin: true,
        // Centered under the menu bar when it fits; a tall section gives up some top padding.
        start: () => {
          const room = innerHeight - BAR, over = section.offsetHeight - room;
          return over <= 0 ? `center ${BAR + room / 2}px` : `top ${BAR - Math.min(over, 64)}px`;
        },
        end: () => `+=${Math.round(innerHeight * 2.4)}`,
        scrub: 0.5,
        invalidateOnRefresh: true,
        snap: {
          // Resting on a point stays there; any scroll moves one point in its direction.
          snapTo: (v: number, self?: ScrollTrigger) => {
            if (jumping) return self ? self.progress : v; // where the click landed, not where momentum would carry it
            const near = POINTS.find((q) => Math.abs(q - v) < 0.01);
            return near ?? nextPoint(v, self?.direction ?? 1);
          },
          duration: { min: 0.5, max: 1.4 },
          delay: 0.1,
          ease: 'power1.inOut',
        },
      },
    });
    st = tween.scrollTrigger!;
    render(0);
    return () => {
      scrubbing = false; st = null; current = null;
      section.classList.remove('scrub');
      feats.forEach((x) => x.style.removeProperty('--p'));
      reset(); shown = '';
      if (visible) startCycle();
    };
  });

  // Phones: the headline scrolls away, then the scene and the features under it hold still (pinned)
  // while the scroll plays the beats. No snap: after a flick it would fight the finger.
  gsap.matchMedia().add(`${MOTION} and (max-width: 900px)`, () => {
    const stage = $('vstage');
    scrubbing = true; cycling = false; run++; reset(); shown = '';
    section.classList.add('scrub', 'scrub-phone');
    const proxy = { p: 0 };
    const tween = gsap.to(proxy, {
      p: 1, ease: 'none',
      onUpdate: () => render(proxy.p),
      scrollTrigger: {
        trigger: section, pin: true, anticipatePin: 1,
        start: () => `top+=${Math.round(stage.getBoundingClientRect().top - section.getBoundingClientRect().top - BAR - 8)} top`,
        end: () => `+=${Math.round(innerHeight * 1.8)}`,
        scrub: 0.4, invalidateOnRefresh: true,
      },
    });
    st = tween.scrollTrigger!;
    render(0);
    return () => {
      scrubbing = false; st = null; current = null;
      section.classList.remove('scrub', 'scrub-phone');
      feats.forEach((x) => x.style.removeProperty('--p'));
      reset(); shown = '';
      if (visible) startCycle();
    };
  });
</script>
