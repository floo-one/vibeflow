---
// The app icon: four white bars on the blue-violet gradient. Decorative wherever it appears.
interface Props { size?: number }
const { size = 30 } = Astro.props;
// Gradient ids must be unique on a page; every use on one page has its own size.
const id = `ic-${size}`;
---
<svg width={size} height={size} viewBox="0 0 30 30" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6B70FF" />
      <stop offset="1" stop-color="#4030C7" />
    </linearGradient>
  </defs>
  <rect width="30" height="30" rx="7" fill={`url(#${id})`} />
  <rect x="6.5" y="12" width="2.6" height="6" rx="1.3" fill="#FFFFFF" />
  <rect x="11.2" y="8" width="2.6" height="14" rx="1.3" fill="#FFFFFF" />
  <rect x="15.9" y="10" width="2.6" height="10" rx="1.3" fill="#FFFFFF" />
  <rect x="20.6" y="13" width="2.6" height="4" rx="1.3" fill="#FFFFFF" />
</svg>
