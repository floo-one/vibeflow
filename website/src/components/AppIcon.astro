---
// The app icon, "the ace": a white playing card with the five voice bars as its suit on a flat
// indigo tile. Same shapes as scripts/make-icons.swift. Decorative wherever it appears.
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 1024 1024" aria-hidden="true">
  <rect x="100" y="100" width="824" height="824" rx="185" fill="#3A2FBF" />
  <rect x="292" y="180" width="440" height="664" rx="48" fill="#FFFFFF" />
  <text x="340" y="312" font-family="-apple-system, BlinkMacSystemFont, 'Inter Variable', Inter, system-ui, sans-serif" font-weight="900" font-size="120" fill="#3A2FBF">A</text>
  <text x="684" y="712" font-family="-apple-system, BlinkMacSystemFont, 'Inter Variable', Inter, system-ui, sans-serif" font-weight="900" font-size="120" fill="#3A2FBF" transform="rotate(180 684 712)">A</text>
  <rect x="378" y="457" width="36" height="110" rx="18" fill="#3A2FBF" />
  <rect x="436" y="417" width="36" height="190" rx="18" fill="#3A2FBF" />
  <rect x="494" y="382" width="36" height="260" rx="18" fill="#F5B82E" />
  <rect x="552" y="417" width="36" height="190" rx="18" fill="#3A2FBF" />
  <rect x="610" y="457" width="36" height="110" rx="18" fill="#3A2FBF" />
</svg>
