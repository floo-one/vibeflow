---
// A Voice card: coloured icon tile (slot "icon"), title, subtitle, text, then shortcut rows.
interface Props { title: string; subtitle: string; color: string }
const { title, subtitle, color } = Astro.props;
---
<article class="card">
  <div class="head">
    <span class="tile" style={`background: ${color}`}><slot name="icon" /></span>
    <div><h3>{title}</h3><span class="sub">{subtitle}</span></div>
  </div>
  <p class="text"><slot name="text" /></p>
  <div><slot /></div>
</article>

<style>
  .card {
    display: flex; flex-direction: column; gap: 14px;
    padding: 26px 26px 14px; border-radius: var(--radius-card); background: var(--ground-2);
  }
  .head { display: flex; align-items: center; gap: 12px; }
  h3 { font-size: 22px; font-weight: 700; }
  .sub { font-size: 14px; color: var(--text-3); }
  .text { font-size: 16px; line-height: 1.55; color: var(--text-2); }
</style>
